{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proceed Graph Export",
  "type": "object",
  "required": ["run_id", "status", "graph_version_id", "definition_digest", "nodes", "edges", "artifacts"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["running", "completed", "failed", "cancelled", "abandoned"] },
    "graph_version_id": { "type": "string", "minLength": 1 },
    "definition_digest": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_key", "status", "attempt_count", "type"],
        "properties": {
          "node_key": { "type": "string" },
          "status": { "type": "string" },
          "attempt_count": { "type": "integer", "minimum": 0 },
          "type": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type", "traversed"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string" },
          "condition": { "type": "string" },
          "route": { "type": "string" },
          "traversed": { "type": "boolean" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["produced_by_node_key", "name", "path", "content_hash", "media_type", "size_bytes", "truncated"],
        "properties": {
          "produced_by_node_key": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "content_hash": { "type": "string" },
          "media_type": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "truncated": { "type": "boolean" }
        }
      }
    }
  }
}
